# Media MCP Server Configuration
# This file is versioned in git as a template.
# Each machine should have its own config.yml with real credentials.
#
# Usage:
#   cp config.yml.example config.yml
#   # Edit config.yml with your API keys
#   ./media-mcp          # or: MEDIA_MCP_CONFIG=config.yml ./media-mcp
#
# Variable expansion: ${VAR_NAME} is replaced from environment at startup.
# Example: api_key: ${SENSENOVA_API_KEY}

default_supplier: senseNova

suppliers:
  # ──────────────────────────────────────────────
  # 1. SenseNova — 商汤科技信息图生成 API
  # ──────────────────────────────────────────────
  senseNova:
    enabled: true
    type: image
    api_key: ${SENSENOVA_API_KEY}
    base_url: https://token.sensenova.cn/v1/images/generations
    model: sensenova-u1-fast
    size: 2752x1536
    extra:
      n: 1          # number of images per request

  # ──────────────────────────────────────────────
  # 2. Agnes AI — Sapiens AI 图像/视频生成平台
  # ──────────────────────────────────────────────
  # 图像模型：agnes-image-2.0-flash、agnes-image-2.1-flash
  # 视频模型：agnes-video-v2.0
  # 关键：response_format 必须放在 extra_body 内部

  # 2.1 Agnes Image 2.0 Flash — 快速版，低信息密度
  agnes_ai:
    enabled: false
    type: image
    api_key: ${AGNES_AI_API_KEY}
    base_url: https://api.agnes-ai.cn/v1/images/generations
    models:
      - agnes-image-2.0-flash
      - agnes-image-2.1-flash
    default_model: agnes-image-2.1-flash
    size: 1024x768
    extra:
      # 支持的 ratio 值（配合 2.1 Flash 使用 size档位如 2K/3K/4K）:
      # 1:1, 3:4, 4:3, 16:9, 9:16, 2:3, 3:2, 21:9
      supported_ratios:
        - 1:1
        - 16:9
        - 9:16
        - 4:3
        - 3:4
        - 2:3
        - 3:2
        - 21:9
      # 支持的 size 档位 (2.1 Flash): 1K, 2K, 3K, 4K
      supports_img2img: true       # 支持输入图片数组
      supports_multi_image: true   # 支持多图合成

  # 2.2 Agnes Video V2.0 — 异步视频生成
  # 注意：视频供应商使用 HTTPGenericAdapter，需配置为 type: video
  agnes_video:
    enabled: false
    type: video
    api_key: ${AGNES_AI_API_KEY}
    base_url: https://api.agnes-ai.cn/v1/videos
    model: agnes-video-v2.0
    extra:
      # 视频生成参数（默认值）
      width: 1152
      height: 768
      num_frames: 121          # 必须 ≤ 441 且遵循 8n + 1 规则
      frame_rate: 24
      # 支持分辨率档位: 480p, 720p, 1080p
      # 支持宽高比: 16:9, 9:16, 1:1, 4:3, 3:4
      # 视频时长: seconds = num_frames / frame_rate
      #   约 3 秒: num_frames=81, frame_rate=24
      #   约 5 秒: num_frames=121, frame_rate=24
      #   约 10 秒: num_frames=241, frame_rate=24
      #   约 18 秒: num_frames=441, frame_rate=24

  # ──────────────────────────────────────────────
  # 3. Doubao Seedream — 火山引擎豆包图像生成
  # ──────────────────────────────────────────────
  # 使用 Agent Plan 专属 API Key 和 Base URL（含 /plan）
  # 参考图数量 + 生成图片数量 ≤ 15 张
  # 抵扣系数：1 张成功生成的图片 = 99 AFP
  doubao_seedream:
    enabled: false
    type: image
    api_key: ${VOLC_API_KEY}          # 火山方舟 Agent Plan API Key
    base_url: https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
    model: doubao-seedream-5.0-lite
    size: 2K
    extra:
      # MCP 工具名默认取配置键名（doubao_seedream_generateImage），
      # 模型升级不影响工具名；如需自定义可取消注释：
      # tool_name: doubao_seedream
      output_format: png           # png 或 jpeg
      watermark: false             # 是否添加水印
      # 支持流式输出 (stream: true)
      # 支持联网搜索 (web_search: true)
      # 支持组图生成 (sequential_image_generation: auto)
      # 支持优化提示词 (optimize_mode: standard 或 fast)
